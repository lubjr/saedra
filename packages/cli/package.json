{
  "name": "@usesaedra/cli",
  "version": "1.0.1",
  "description": "CLI-first architectural memory and AI-powered code review for your codebase",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubjr/seadra.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/lubjr/seadra/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/lubjr/seadra/issues"
  },
  "keywords": [
    "cli",
    "architecture",
    "code-review",
    "ai",
    "architectural-decisions"
  ],
  "type": "module",
  "bin": {
    "saedra": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@inquirer/prompts": "^7.10.1",
    "clipboardy": "^5.3.1",
    "commander": "^13.1.0",
    "openai": "^4.104.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  }
}
